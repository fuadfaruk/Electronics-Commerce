{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x",
    "npm": "12.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=lcov --coverage.reporter=json-summary --reporter=default --reporter=junit --outputFile.junit=test-results/vitest.xml",
    "test:e2e": "node --use-system-ca --require ../scripts/e2e-ca.cjs ../scripts/run-e2e.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@vitest/coverage-v8": "5.0.3",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "fast-glob": "file:./tooling/next-eslint-glob",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "5.0.3"
  },
  "overrides": {
    "@next/eslint-plugin-next@16.4.2": {
      "fast-glob": "$fast-glob"
    }
  }
}
