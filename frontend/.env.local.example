# Copy to .env.local and restart `npm run dev` after changing either value.

# Base URL of the ASP.NET API (see backend/src/ElectroApi.Api/Properties/launchSettings.json).
# Product data is fetched server-side, so the API does not need a CORS policy.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5249

# true  -> the storefront reads src/data/products.mock.ts and makes no API calls.
# false -> every catalog screen reads GET /api/v1/Product from the URL above.
NEXT_PUBLIC_USE_MOCK_DATA=true
