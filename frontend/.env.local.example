# Copy to .env.local when you wire the real API.

# Base URL of the ASP.NET API (backend/src/electroapi.api/Properties/launchSettings.json).
# Only read once a fetch layer replaces the mock in src/lib/catalog/queries.ts.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5249

# The storefront runs entirely on mock data and performs no network requests.
# Leave this as true until the endpoints in the README gap list exist.
NEXT_PUBLIC_USE_MOCK_DATA=true
