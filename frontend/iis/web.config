<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <httpPlatform processPath="%ProgramFiles%\nodejs\node.exe" arguments=".\server.js" startupTimeLimit="60" stdoutLogEnabled="false" processesPerApplication="1">
      <environmentVariables>
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="HOSTNAME" value="127.0.0.1" />
        <environmentVariable name="NODE_ENV" value="production" />
        <environmentVariable name="STOREFRONT_MODE" value="live" />
        <environmentVariable name="API_BASE_URL" value="%API_BASE_URL%" />
        <environmentVariable name="STOREFRONT_URL" value="%STOREFRONT_URL%" />
      </environmentVariables>
    </httpPlatform>
    <httpErrors errorMode="Custom" existingResponse="PassThrough" />
  </system.webServer>
</configuration>
